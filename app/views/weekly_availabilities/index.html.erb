<% content_for :title, "作業可能時間 | しめきりノート" %>

<% weekday_names = %w[月曜日 火曜日 水曜日 木曜日 金曜日 土曜日 日曜日] %>

<section class="mx-auto w-full max-w-2xl">
  <%= link_to "作品詳細へ戻る",
              work_path(@work),
              class: "link link-hover text-sm" %>

  <h1 class="mt-6 text-3xl font-bold">作業可能時間</h1>

  <p class="mt-4 text-lg">週合計：<%= @weekly_total %>時間</p>

  <div class="mt-6 overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>曜日</th>
          <th>作業可能時間</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% @weekly_availabilities.each do |weekly_availability| %>
          <tr>
            <td><%= weekday_names.fetch(weekly_availability.weekday) %></td>
            <td><%= weekly_availability.hours %>時間</td>
            <td>
              <%= link_to "編集",
                          edit_work_weekly_availability_path(@work, weekly_availability),
                          class: "btn btn-outline btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
