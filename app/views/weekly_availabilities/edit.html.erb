<% content_for :title, "作業可能時間を編集 | しめきりノート" %>

<% weekday_names = %w[月曜日 火曜日 水曜日 木曜日 金曜日 土曜日 日曜日] %>

<section class="mx-auto w-full max-w-2xl">
  <%= link_to "作業可能時間一覧へ戻る",
              work_weekly_availabilities_path(@work),
              class: "link link-hover text-sm" %>

  <h1 class="mt-6 text-3xl font-bold">
    <%= weekday_names.fetch(@weekly_availability.weekday) %>の作業可能時間
  </h1>

  <%= form_with model: [ @work, @weekly_availability ],
                class: "mt-8 space-y-6" do |form| %>
    <div>
      <%= form.label :hours, "作業可能時間", class: "label" %>
      <%= form.number_field :hours,
                            min: 0,
                            max: 24,
                            required: true,
                            class: "input input-bordered w-full" %>
      <p class="mt-2 text-sm text-base-content/70">0〜24時間で入力してください。</p>
    </div>

    <%= form.submit "保存する", class: "btn btn-primary w-full" %>
  <% end %>
</section>
