<% content_for :title, "#{@work.title} | しめきりノート" %>

<section class="mx-auto w-full max-w-4xl">
  <%= link_to "作品一覧へ戻る",
              works_path,
              class: "link link-hover text-sm" %>

  <div class="mt-6 rounded-box border border-base-300 p-8">
    <h1 class="text-3xl font-bold"><%= @work.title %></h1>

    <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4">
      <dt class="font-semibold text-base-content/70">作品種別</dt>
      <dd><%= @work.work_type %></dd>

      <dt class="font-semibold text-base-content/70">総量</dt>
      <dd><%= @work.total_quantity %></dd>

      <dt class="font-semibold text-base-content/70">制作開始日</dt>
      <dd><%= l @work.start_date %></dd>

      <dt class="font-semibold text-base-content/70">締切</dt>
      <dd><%= l @work.deadline %></dd>
    </dl>

    <% process_checks_by_pair = @work.process_checks.index_by { |process_check| [ process_check.production_unit_id, process_check.work_process_id ] } %>

    <section class="mt-8">
      <h2 class="text-xl font-bold">進捗</h2>

      <div class="mt-4 flex gap-6">
        <p>完成：<%= @work.completed_quantity %> / <%= @work.total_quantity %></p>
        <p>残り：<%= @work.remaining_quantity %></p>
        <p>進捗率：<%= @work.progress_percentage %>%</p>
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-bold">工程を追加</h2>

      <%= form_with model: [ @work, WorkProcess.new ], class: "mt-4 flex items-end gap-3" do |form| %>
        <div class="form-control">
          <%= form.label :name, "工程名", class: "label" %>
          <%= form.text_field :name, class: "input input-bordered", required: true %>
        </div>

        <div class="form-control">
          <%= form.label :position, "工程の順番", class: "label" %>
          <%= form.number_field :position,
                                value: @work.work_processes.maximum(:position).to_i + 1,
                                min: 1,
                                max: 10,
                                class: "input input-bordered w-28",
                                required: true %>
        </div>

        <%= form.submit "工程を追加する", class: "btn btn-primary" %>
      <% end %>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-bold">工程チェック表</h2>

      <div class="mt-4 overflow-x-auto">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>制作対象</th>

              <% @work.work_processes.each do |work_process| %>
                <th><%= work_process.name %></th>
              <% end %>
            </tr>
          </thead>

          <tbody>
            <% @work.production_units.each do |production_unit| %>
              <tr>
                <th><%= production_unit.position %></th>

                <% @work.work_processes.each do |work_process| %>
                  <% process_check = process_checks_by_pair.fetch(
                    [ production_unit.id, work_process.id ]
                  ) %>

                  <td>
                    <%= button_to(
                      process_check.checked? ? "完了" : "未完了",
                      process_check_path(process_check),
                      method: :patch,
                      params: {
                        process_check: { checked: !process_check.checked? }
                      },
                      class: process_check.checked? ? "btn btn-success btn-sm" : "btn btn-outline btn-sm"
                    ) %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="mt-8 flex gap-3">
      <%= link_to "編集",
                  edit_work_path(@work),
                  class: "btn btn-outline" %>

      <%= button_to "削除",
                    work_path(@work),
                    method: :delete,
                    data: { turbo_confirm: "「#{@work.title}」を削除しますか？" },
                    class: "btn btn-error" %>
    </div>
  </div>
</section>
