<% if @work.errors.any? %>
  <div role="alert" class="alert alert-error mt-6">
    <div>
      <p class="font-bold">入力内容を確認してください。</p>

      <ul class="mt-2 list-disc pl-5">
        <% @work.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

<% work_type_options = [["漫画", "manga"], ["小説", "novel"], ["イラスト", "illustration"]] %>

<%= form_with model: @work, class: "mt-8 space-y-6" do |form| %>
  <div>
    <%= form.label :title, "作品名", class: "label" %>
    <%= form.text_field :title, class: "input input-bordered w-full" %>
  </div>

  <div>
    <% if @work.persisted? %>
      <p class="label">作品種別</p>
      <p class="rounded-field border border-base-300 px-3 py-2">
        <%= work_type_options.to_h.invert.fetch(@work.work_type) %>
      </p>
    <% else %>
      <%= form.label :work_type, "作品種別", class: "label" %>
      <%= form.select :work_type,
                      work_type_options,
                      {},
                      class: "select select-bordered w-full" %>
    <% end %>
  </div>

  <div>
    <%= form.label :total_quantity, "総量", class: "label" %>
    <%= form.number_field :total_quantity,
                          min: 1,
                          max: 999,
                          class: "input input-bordered w-full" %>
  </div>

  <div>
    <%= form.label :start_date, "制作開始日", class: "label" %>
    <%= form.date_field :start_date, class: "input input-bordered w-full" %>
  </div>

  <div>
    <%= form.label :deadline, "締切", class: "label" %>
    <%= form.date_field :deadline, class: "input input-bordered w-full" %>
  </div>

  <%= form.submit @work.persisted? ? "作品を更新する" : "作品を作成する",
                  class: "btn btn-primary w-full" %>
<% end %>
