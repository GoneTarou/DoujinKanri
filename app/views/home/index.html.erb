<% content_for :title, "しめきりノート" %>

<section class="mx-auto w-full max-w-3xl text-center">
  <p class="text-primary font-semibold">同人制作の進捗管理</p>

  <h1 class="mt-3 text-5xl font-bold tracking-tight">
    しめきりノート
  </h1>

  <p class="mt-6 text-lg leading-8 text-base-content/70">
    締切と作業できる時間から、<br>
    今日進める完成量の目安を確認できる制作計画アプリです。
  </p>

  <% if user_signed_in? %>
    <div class="mt-10">
      <p class="text-lg font-bold text-primary">
        ゲストとして利用中です
      </p>

      <p class="mt-3 text-sm text-base-content/60">
        作品作成機能の実装後に、ここから制作計画を作成できます。
      </p>
    </div>
  <% else %>
    <div class="mt-10 flex justify-center gap-4">
      <%= button_to "ゲストとして始める",
                    guest_session_path,
                    method: :post,
                    class: "btn btn-primary btn-lg" %>

      <button class="btn btn-outline btn-lg" disabled>
        Googleでログイン
      </button>
    </div>

    <p class="mt-4 text-sm text-base-content/60">
      Googleログインは今後対応します。
    </p>
  <% end %>
</section>
